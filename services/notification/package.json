{
  "name": "@sbb-lost-found/notification-service",
  "version": "1.0.0",
  "description": "Real-time notification service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec tsx src/index.ts",
    "start": "node dist/index.js",
