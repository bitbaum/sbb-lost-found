{
  "name": "@sbb-lost-found/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for SBB Lost and Found system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sbb-lost-found/types": "workspace:*",
    "cors": "^2.8.6",
    "express": "^4.18.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^26.4.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
