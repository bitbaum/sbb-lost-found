# Local development only. Next loads this file for `next dev` and never for a
# production build, which is the point: these values must not reach a deployed
# bundle. Without them the app runs on deliberate demo data (see lib/config.ts).
#
# Port 3001 is the reporting service, which is what the frontend has talked to
# in dev; the api-gateway's compose default (3000) collides with the Next dev
# server itself. Port 3003 is the notification service per docker-compose.yml —
# the previous config pointed the socket at 3001, which never had one.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3003
